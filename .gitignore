# Dependencies
node_modules/
dist/

# POG-VIBE Local State (runtime-generated)
~/.pog-coder-vibe/
.pog_coder_vibe/
performance.json
vibe-learning.db
snapshots/

# Environment / Secret Files
.env
.env.*
!.env.example

# Logs and Debug (specific patterns, not blanket exclusion)
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
*.tsbuildinfo

# Test artifacts (temporary)
test-project/
temp_pog_test/
env_test/
gemini-test/

# OS specific files
.DS_Store
Thumbs.db

# IDE specific files (optional - can be removed if team wants shared settings)
*.swp
*.swo

# Keep these files tracked:
# - *.txt (wrangler_ai_models.txt, gcloud help files are useful reference)
# - *.log (build logs may be useful for debugging)
# - .vscode/ (workspace settings can be shared)
# - src/templates/ (required for scaffolding)
# - cli/ (required for application)
# - docs/ (documentation)
