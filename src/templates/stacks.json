{
    "react-vite": {
        "init": "npx -y create-vite@latest . --template react-ts",
        "install": "npm install && npm install -D tailwindcss postcss autoprefixer && npx tailwindcss init -p",
        "devCommand": "npm run dev",
        "defaultPort": 5173,
        "description": "React + Vite + TypeScript + Tailwind"
    },
    "react-vite-sovereign": {
        "init": "npx -y create-vite@latest . --template react-ts",
        "install": "npm install && npm install -D tailwindcss postcss autoprefixer @types/node",
        "devCommand": "npm run dev",
        "defaultPort": 5173,
        "description": "React + Vite with Sovereign UI pre-configured"
    },
    "nextjs": {
        "init": "npx -y create-next-app@latest . --typescript --tailwind --eslint --app --src-dir --import-alias \"@/*\" --use-npm",
        "install": "npm install",
        "devCommand": "npm run dev",
        "defaultPort": 3000,
        "description": "Next.js 14 with App Router"
    },
    "vue-vite": {
        "init": "npx -y create-vite@latest . --template vue-ts",
        "install": "npm install",
        "devCommand": "npm run dev",
        "defaultPort": 5173,
        "description": "Vue 3 + Vite + TypeScript"
    },
    "svelte-kit": {
        "init": "npx -y create-svelte@latest .",
        "install": "npm install",
        "devCommand": "npm run dev",
        "defaultPort": 5173,
        "description": "SvelteKit with TypeScript"
    }
}