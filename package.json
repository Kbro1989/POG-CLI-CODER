{
  "name": "pog-coder-vibe",
  "version": "1.0.0",
  "description": "Terminal-first AI coding assistant with binary-optimized routing",
  "type": "module",
  "bin": {
    "pog": "./dist/cli.cjs"
  },
  "engines": {
    "node": ">=20.0.0"
  },
  "scripts": {
    "start": "node cli/entry.js",
    "dev": "tsx watch cli/index.ts",
    "build": "tsc && node scripts/build-cli.js",
    "build:all": "npx tsx scripts/build-all.ts",
    "build:deploy": "npx tsx scripts/build-all.ts --deploy",
    "pog": "node dist/cli.cjs",
    "demo": "tsx tests/demo.ts",
    "test": "node --experimental-vm-modules node_modules/jest/bin/jest.js",
    "test:watch": "npm run test -- --watch",
    "test:routes": "tsx tests/test_routes.ts",
    "test:outputs": "tsx tests/test_outputs.ts",
    "test:trinity": "tsx tests/test_trinity_failover.ts",
    "test:pathing": "tsx tests/test-pathing.ts",
    "test:gemini": "tsx tests/verify-gemini-preview.ts",
    "test:cli-fallback": "tsx tests/verify_cli_fallback.ts",
    "test:all": "npm test && npm run test:routes && npm run test:outputs && npm run test:trinity",
    "lint": "eslint src cli --ext .ts",
    "typecheck": "tsc --noEmit",
    "typecheck:extension": "cd vscode-extension && tsc --noEmit",
    "typecheck:worker": "cd src/workers/pog-vibe-worker && tsc --noEmit",
    "typecheck:gateway": "cd hello-ai-gateway && tsc --noEmit",
    "typecheck:all": "npm run typecheck && npm run typecheck:extension && npm run typecheck:worker && npm run typecheck:gateway",
    "verify:drift": "tsx tests/verifyIntentDrift.ts",
    "verify:conversational": "tsx tests/verify_conversational.ts",
    "verify:cross-limb": "tsx tests/verify_cross_limb.ts",
    "verify:health": "tsx tests/verify_health_routing.ts",
    "verify:rag": "tsx tests/verify_rag.ts",
    "verify:routing": "tsx tests/verify_routing_logic.ts",
    "verify:sandbox": "tsx tests/verify_sandbox.ts",
    "verify:capabilities": "tsx tests/check_capabilities.ts",
    "verify:hexagram": "tsx tests/hexagram-verify.ts",
    "verify:kimi": "tsx tests/verify_kimi_reasoning.ts",
    "verify:all": "npm run verify:routing && npm run verify:cross-limb && npm run verify:sandbox && npm run verify:rag && npm run verify:health && npm run verify:drift && npm run verify:conversational && npm run verify:kimi",
    "health:quick": "tsx tests/health-check.ts",
    "health:verify": "tsx tests/test_model_health.ts",
    "health:all": "npm run health:quick && npm run health:verify && npm run test:outputs && npm run verify:kimi",
    "monitor": "tsx src/monitor/MonitorAgent.ts",
    "monitor:tsc": "tsx src/monitor/TSCMonitor.ts",
    "gemini:list": "tsx tests/list_gemini_models.ts",
    "index:refs": "tsx tests/index_references.ts",
    "build:extension": "cd vscode-extension && npm run compile",
    "deploy:gateway": "cd hello-ai-gateway && npm run deploy",
    "deploy:worker": "cd src/workers/pog-vibe-worker && npm run deploy",
    "deploy:all": "npm run deploy:gateway && npm run deploy:worker",
    "cf:cli": "tsx src/apps/cloudflare/cli.ts",
    "cf:serve": "wrangler dev src/apps/cloudflare/worker.ts --config src/apps/cloudflare/wrangler.toml --port 8787",
    "fleet:list": "tsx scripts/wrangler-fleet.ts --list",
    "fleet:dev": "tsx scripts/wrangler-fleet.ts --dev",
    "fleet:build": "tsx scripts/wrangler-fleet.ts --build",
    "fleet:deploy": "tsx scripts/wrangler-fleet.ts --deploy",
    "fleet:html-dev": "tsx scripts/wrangler-fleet.ts --dev --html",
    "pog:health": "npm run health:verify",
    "registry:gen": "tsx tests/generateRegistry.ts && tsx tests/generateCloudflareRegistry.ts",
    "vscode:package": "cd vscode-extension && vsce package",
    "pog:link": "npm link --force",
    "prepare": "husky install"
  },
  "dependencies": {
    "@google-cloud/language": "^7.2.1",
    "@google-cloud/translate": "^9.3.0",
    "@google-cloud/vision": "^5.3.4",
    "@google/genai": "^1.36.0",
    "@ledgerhq/compressjs": "^1.3.2",
    "@modelcontextprotocol/sdk": "^1.26.0",
    "chalk": "^5.6.2",
    "chokidar": "^3.6.0",
    "deps": "^1.0.0",
    "diff": "^8.0.3",
    "dotenv": "^17.2.3",
    "globby": "^14.0.2",
    "ignore": "^7.0.5",
    "lodash": "^4.17.21",
    "partyserver": "^0.1.5",
    "pino": "^8.19.0",
    "pino-pretty": "^10.3.1",
    "prompts": "^2.4.2",
    "simple-git": "^3.32.3",
    "sqlite": "^5.1.1",
    "sqlite3": "^5.1.7",
    "tree-sitter": "^0.21.1",
    "tree-sitter-typescript": "^0.21.2",
    "wavefile": "^11.0.0",
    "ws": "^8.18.0",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^4.20260214.0",
    "@google-cloud/speech": "^7.2.1",
    "@google-cloud/text-to-speech": "^6.4.0",
    "@google/generative-ai": "^0.24.1",
    "@types/diff": "^5.0.8",
    "@types/globby": "^9.1.0",
    "@types/jest": "^30.0.0",
    "@types/lodash": "^4.14.202",
    "@types/node": "^20.14.0",
    "@types/prompts": "^2.4.9",
    "@types/sqlite3": "^3.1.11",
    "@types/vscode": "^1.109.0",
    "@types/ws": "^8.5.12",
    "@typescript-eslint/eslint-plugin": "^6.21.0",
    "@typescript-eslint/parser": "^6.21.0",
    "@vscode/vsce": "^3.0.0",
    "esbuild": "^0.28.1",
    "eslint": "^8.56.0",
    "husky": "^8.0.3",
    "jest": "^29.7.0",
    "ts-jest": "^29.4.6",
    "tsx": "^4.19.1",
    "typescript": "^5.6.2",
    "vitest": "^4.0.18"
  },
  "keywords": [
    "ai",
    "coding",
    "terminal",
    "free",
    "local"
  ],
  "author": "POG Community",
  "license": "MIT",
  "overrides": {
    "tar": "^7.5.3"
  },
  "main": "./dist/cli.cjs",
  "directories": {
    "doc": "docs",
    "test": "tests"
  }
}