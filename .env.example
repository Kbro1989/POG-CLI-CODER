# POG-CODER-VIBE Environment Configuration
# Copy this file to .env and fill in your values

# ═══════════════════════════════════════════════════════════════════════════════
# CORE PATHS (Required)
# ═══════════════════════════════════════════════════════════════════════════════

# Primary POG data directory (sovereign state, sessions, performance DB)
POG_DIR=D:\pog-coder-vibe

# Ollama models path (set if not default ~/.ollama/models)
POG_ERROR_TRACKER_PATH=D:\ollama-models

# Gutenberg knowledge base path
POG_GUTENBERG_PATH=D:\pog-gutenberg

# ═══════════════════════════════════════════════════════════════════════════════
# SERVER CONFIGURATION
# ═══════════════════════════════════════════════════════════════════════════════

# WebSocket port for VS Code extension bridge
VIBE_WS_PORT=8765

# Log level: trace | debug | info | warn | error
VIBE_LOG_LEVEL=info

# ═══════════════════════════════════════════════════════════════════════════════
# AI PROVIDERS (At least one required for cloud fallback)
# ═══════════════════════════════════════════════════════════════════════════════

# Google Gemini API Key (required for Gemini SDK fallback)
GOOGLE_API_KEY=

# Cloudflare AI Gateway URL (for Workers AI models)
CLOUDFLARE_GATEWAY_URL=https://pog-vibe-worker.<your-subdomain>.workers.dev

# Cloudflare API Token (preferred) or API Key
CLOUDFLARE_API_TOKEN=
CLOUDFLARE_API_KEY=

# Cloudflare Account ID (for direct API calls)
CLOUDFLARE_ACCOUNT_ID=

# ═══════════════════════════════════════════════════════════════════════════════
# MODEL OVERRIDES (Optional - defaults to ternary routing)
# ═══════════════════════════════════════════════════════════════════════════════

# Force specific models for specific roles (bypass routing)
VIBE_MONITOR_MODEL=
VIBE_PLANNING_MODEL=
VIBE_CRITIC_MODEL=
VIBE_SNAPSHOT_MODEL=

# ═══════════════════════════════════════════════════════════════════════════════
# ADVANCED (Optional)
# ═══════════════════════════════════════════════════════════════════════════════

# Cloudflare Worker URL (legacy, use GATEWAY_URL instead)
CLOUDFLARE_WORKER_URL=
