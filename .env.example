# Server Configuration
VIBE_WS_PORT=8765
VIBE_LOG_LEVEL=info

# Cloudflare Sidecar Worker (Optional but recommended for Rate Limiting/Durable Objects)
CLOUDFLARE_WORKER_URL=https://pog-vibe-worker.<your-subdomain>.workers.dev

